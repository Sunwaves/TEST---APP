# Local development: `npm start` runs a private Postgres on port 54329 using these.
# For a hosted database (e.g. Neon), set both to its pooled and direct connection strings.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/goldie"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:54329/goldie"

# Optional. Leave unset to keep email/SMS simulated (recorded in Dashboard → Messages only).
# APP_URL="https://your-app.vercel.app"    # base for links in messages; defaults to the request's host
# RESEND_API_KEY=""                         # real email via Resend
# EMAIL_FROM="Your Salon <bookings@your-domain.com>"
# TWILIO_ACCOUNT_SID=""                     # real SMS via Twilio
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+447700900000"
# CRON_SECRET=""                            # enables GET /api/cron/messages for scheduled reminder delivery

# Optional. PRO plan payments (Stripe). Without these, the Upgrade button says payments aren't set up.
# STRIPE_SECRET_KEY="sk_test_..."           # Stripe → Developers → API keys
# STRIPE_PRICE_ID="price_..."               # the 150 RON monthly price (tax-inclusive)
# STRIPE_WEBHOOK_SECRET="whsec_..."         # from the webhook endpoint for /api/stripe/webhook
